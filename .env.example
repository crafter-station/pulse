# Neon serverless Postgres connection string
DATABASE_URL=

# GitHub org webhook secret (openssl rand -hex 32) — required to verify webhooks
GITHUB_WEBHOOK_SECRET=

# GitHub token with read access to org repos (for backfill / API enrichment)
GITHUB_TOKEN=

# Shared secret protecting mutation endpoints (e.g. /api/leaderboard/snapshot).
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
